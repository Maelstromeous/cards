{
  "name": "@humanity-deck/shared",
  "version": "0.0.1",
  "private": true,
  "description": "Interfaces and constants shared by the API and the website.",
  "type": "module",
  "exports": {
    "./interfaces/*": {
      "types": "./dist/interfaces/*.d.ts",
      "default": "./dist/interfaces/*.js"
    },
    "./constants/*": {
      "types": "./dist/constants/*.d.ts",
      "default": "./dist/constants/*.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "prepare": "tsc -p tsconfig.json"
  },
  "engines": {
    "node": ">=26"
  },
  "devDependencies": {
    "typescript": "~6.0.3"
  }
}
