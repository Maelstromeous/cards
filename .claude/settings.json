{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm install*)",
      "Bash(pnpm test*)",
      "Bash(pnpm build*)",
      "Bash(pnpm lint*)",
      "Bash(pnpm format*)",
      "Bash(pnpm exec tsc --noEmit*)",
      "Bash(pnpm exec eslint*)",
      "Bash(pnpm exec jest*)",
      "Bash(pnpm --filter*)",
      "Bash(NODE_OPTIONS=--openssl-legacy-provider pnpm build*)"
    ]
  }
}
