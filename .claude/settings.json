{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(yarn install*)",
      "Bash(yarn test*)",
      "Bash(yarn build*)",
      "Bash(yarn lint*)",
      "Bash(yarn format*)",
      "Bash(npx tsc --noEmit*)",
      "Bash(npx eslint*)",
      "Bash(npx jest*)",
      "Bash(NODE_OPTIONS=--openssl-legacy-provider yarn build*)"
    ]
  }
}
